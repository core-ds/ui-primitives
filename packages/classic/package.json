{
    "name": "@alfalab/icons-classic",
    "version": "2.10.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/ui-primitives.git",
        "directory": "packages/classic"
    },
    "license": "MIT",
    "sideEffects": false,
    "scripts": {
        "build": "build-icon-package && prepare-package-json-for-publish --out dist/package.json",
        "clean": "rimraf dist",
        "codegen": "svg-to-component '../../icons/icon/*.svg' --out src"
    },
    "devDependencies": {
        "@alfalab/icons-tsconfig": "workspace:*",
        "@types/react": "catalog:",
        "build-icon-package": "workspace:*",
        "prepare-package-json-for-publish": "workspace:*",
        "react": "catalog:",
        "rimraf": "catalog:",
        "svg-to-component": "workspace:*",
        "tslib": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "react": "^16.9.0 || ^17.0.1 || ^18.0.0 || ^19.0.0",
        "react-dom": "^16.9.0 || ^17.0.1 || ^18.0.0 || ^19.0.0"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist"
    }
}
