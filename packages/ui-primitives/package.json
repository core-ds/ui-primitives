{
    "name": "ui-primitives",
    "version": "36.14.0",
    "description": "UI primitives for sharing between platforms in Design System Team projects",
    "keywords": [
        "design",
        "ui",
        "icons",
        "svg"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/ui-primitives.git",
        "directory": "packages/ui-primitives"
    },
    "license": "MIT",
    "sideEffects": false,
    "scripts": {
        "build": "cpy \"../../{animations,icons,styles}\" dist && cpy README.md dist && prepare-package-json-for-publish --out dist/package.json",
        "clean": "rimraf dist"
    },
    "devDependencies": {
        "cpy-cli": "^7.0.0",
        "prepare-package-json-for-publish": "workspace:*",
        "rimraf": "^6.1.3"
    },
    "publishConfig": {
        "access": "public",
        "directory": "dist"
    }
}
