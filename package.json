{
    "name": "@alfalab/ui-primitives-repository",
    "version": "0.0.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/ui-primitives.git"
    },
    "license": "MIT",
    "workspaces": [
        "icons-demo",
        "packages/*",
        "scripts/*"
    ],
    "scripts": {
        "bootstrap": "yarn workspaces foreach --all --parallel --topological-dev run bootstrap",
        "build": "yarn workspaces foreach --all --parallel --topological-dev run build",
        "clean": "yarn workspaces foreach --all --parallel --topological-dev run clean",
        "codegen": "yarn workspaces foreach --all --topological-dev run codegen && yarn format",
        "format": "prettier --log-level silent --write \"./**/*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,css,json,yml,md}\"",
        "format-check": "prettier --check \"./**/*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,css,json,yml,md}\"",
        "lint": "lint-svg \"./icons/**/*.svg\" --exit-code 0",
        "version-packages": "yarn changeset version && yarn format"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "export-icon-meta": "workspace:*",
        "export-typography": "workspace:*",
        "lint-staged": "^17.6.0",
        "lint-svg": "workspace:*",
        "prettier": "^3.9.9",
        "simple-git-hooks": "^2.14.0",
        "sort-package-json": "4.0.0"
    }
}
