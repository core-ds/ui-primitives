{
    "name": "@alfalab/ui-primitives-repository",
    "version": "0.0.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/ui-primitives.git"
    },
    "license": "MIT",
    "type": "module",
    "scripts": {
        "bootstrap": "pnpm -r run bootstrap && pnpm rebuild",
        "build": "pnpm -r --sequential run build",
        "build-cdn-dist": "pnpm build-cdn 'icons/*/*.svg' --ignore icons/android icons/logo-am icons/dev --out cdn-dist/icons",
        "clean": "pnpm -r run clean",
        "codegen": "pnpm -r run codegen && pnpm format",
        "format": "pnpm format-check --log-level silent --write",
        "format-check": "prettier --check \"./**/*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,css,json,yml,yaml,md}\"",
        "lint-icons": "lint-svg",
        "lint-js": "pnpm -r run lint",
        "version-packages": "changeset version && pnpm format"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@tsconfig/node24": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native": "catalog:",
        "build-cdn": "workspace:*",
        "lint-staged": "^17.6.0",
        "lint-svg": "workspace:*",
        "prettier": "^3.9.9",
        "simple-git-hooks": "^2.14.0",
        "sort-package-json": "4.0.0"
    },
    "packageManager": "pnpm@12.22.0"
}
