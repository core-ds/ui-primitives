{
    "name": "@alfalab/ui-primitives-repository",
    "version": "0.0.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/core-ds/ui-primitives.git"
    },
    "license": "MIT",
    "scripts": {
        "bootstrap": "pnpm -r run bootstrap && pnpm rebuild",
        "build": "pnpm -r --sequential run build",
        "clean": "pnpm -r run clean",
        "codegen": "pnpm -r run codegen && pnpm format",
        "figma:connect:catalog": "node scripts/code-connect/catalog.cjs",
        "figma:connect:check": "node scripts/code-connect/check.cjs",
        "figma:connect:generate": "node scripts/code-connect/generate.cjs",
        "figma:connect:publish": "figma connect publish --config figma.config.json",
        "format": "pnpm format-check --log-level silent --write",
        "format-check": "prettier --check \"./**/*.{ts,tsx,js,jsx,mjs,mts,cjs,cts,css,json,yml,yaml,md}\"",
        "lint-icons": "lint-svg \"./icons/**/*.svg\" --exit-code 0",
        "lint-js": "pnpm -r run lint",
        "version-packages": "changeset version && pnpm format"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@figma/code-connect": "1.4.9",
        "@types/react": "catalog:",
        "export-icon-meta": "workspace:*",
        "export-typography": "workspace:*",
        "lint-staged": "^17.6.0",
        "lint-svg": "workspace:*",
        "prettier": "^3.9.9",
        "react": "catalog:",
        "simple-git-hooks": "^2.14.0",
        "sort-package-json": "4.0.0",
        "typescript": "catalog:"
    },
    "packageManager": "pnpm@12.15.0"
}
